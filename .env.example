# ============================================================
# .env.example — Copy this to .env and fill in your values
# NEVER commit the real .env file to git
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/job_agent_db
DATABASE_URL_SYNC=postgresql://postgres:yourpassword@localhost:5432/job_agent_db

# --- Redis (Task Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=your-fernet-key-here

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- CAPTCHA ---
TWOCAPTCHA_API_KEY=your-2captcha-api-key-here

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- App Settings ---
APP_NAME=Job Search AI Agent
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# --- Rate Limiting ---
MAX_APPLICATIONS_PER_DAY=50
JOB_MATCH_THRESHOLD=70
